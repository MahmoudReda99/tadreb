{
  // Cloudflare Workers static-assets deploy: publishes the Vite build (run `npm run build` first)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenda",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
